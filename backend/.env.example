# Email Privacy Analyzer (EPA) Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# JWT & Crypto
SECRET_KEY=super-secret-epa-key-change-in-production-cybersec-2026
ENCRYPTION_KEY=uO_v9wU72dGkQZ2bY1dNx-3a6x6l4N8Z0p9a8K5r8xM=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# If MongoDB is running locally, use mongodb://localhost:27017
# Or for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net
# If unreachable, the server automatically falls back to safe in-memory mongomock
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=email_privacy_analyzer

# Ollama Local LLM
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
AI_ENABLED_DEFAULT=True

# Google OAuth 2.0 / Gmail API (Read-only)
# Optional: If left blank, EPA runs in seamless demonstration mode
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/gmail/callback

# Security & Limits
RATE_LIMIT_PER_MINUTE=120
MAX_FILE_SIZE_BYTES=20971520
