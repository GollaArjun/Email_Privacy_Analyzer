{
  "name": "email-privacy-analyzer",
  "version": "1.0.0",
  "description": "Enterprise Cybersecurity & Email Privacy Analyzer Web Application",
  "private": true,
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "dev:backend": "set PYTHONPATH=backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "test:backend": "set PYTHONPATH=backend && python -m pytest tests/backend -v"
  },
  "keywords": [
    "cybersecurity",
    "privacy",
    "email-analyzer",
    "pii-detection",
    "phishing-detection",
    "presidio",
    "fastapi",
    "react"
  ],
  "author": "Email Privacy Analyzer Team",
  "license": "MIT"
}
